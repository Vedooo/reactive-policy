{"version": 2, "width": 92, "height": 28, "timestamp": 1748044800, "title": "reactive-policy: rp CLI", "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.4, "o", "$ "]
[0.9, "o", "rp plugin list\r\n"]
[1.2, "o", "NAME             REVERSIBLE   PERMISSIONS   DESCRIPTION\r\n"]
[1.25, "o", "argocd.suspend   true         1             Suspends auto-sync on a target ArgoCD Application.\r\n"]
[1.30, "o", "k8s.annotate     true         1             Adds or updates an annotation on the target resource.\r\n"]
[1.35, "o", "notify.slack     false        1             Sends a message to a Slack channel via an incoming webhook.\r\n"]
[2.0, "o", "$ "]
[2.6, "o", "rp policy list -A\r\n"]
[2.9, "o", "NAMESPACE    NAME                    STATE        LAST TRIGGERED   COUNT   VALUE   AGE\r\n"]
[2.95, "o", "production   api-error-rate-guard    Watching     2m               4       0.012   6d\r\n"]
[3.00, "o", "production   checkout-latency-guard  Cooldown     45s              2       1.8     6d\r\n"]
[3.05, "o", "staging      queue-depth-guard       RateLimited  10s              5       920     3d\r\n"]
[3.8, "o", "$ "]
[4.4, "o", "rp policy describe api-error-rate-guard -n production\r\n"]
[4.7, "o", "Name:        api-error-rate-guard\r\n"]
[4.72, "o", "Namespace:   production\r\n"]
[4.74, "o", "State:       Watching\r\n"]
[4.76, "o", "Value:       0.012\r\n"]
[4.78, "o", "Triggers:    4\r\n"]
[4.80, "o", "Observe:\r\n"]
[4.82, "o", "  Source:    prometheus\r\n"]
[4.84, "o", "  Endpoint:  http://prometheus.monitoring:9090\r\n"]
[4.86, "o", "  Condition: value GreaterThan 0.05 for 2m0s\r\n"]
[4.88, "o", "Cooldown:    10m0s\r\n"]
[4.90, "o", "Actions:\r\n"]
[4.92, "o", "  0. argocd.suspend (onFailure=stop)\r\n"]
[4.94, "o", "  1. notify.slack (onFailure=continue)\r\n"]
[5.6, "o", "$ "]
[6.2, "o", "rp action audit --since 1h -n production\r\n"]
[6.5, "o", "NAME                          POLICY                 TRIGGERED   ACTIONS   OUTCOME     REVERTED\r\n"]
[6.55, "o", "api-error-rate-guard-7gk2x    api-error-rate-guard   12m ago     2         Succeeded   false\r\n"]
[6.60, "o", "api-error-rate-guard-q4m9p    api-error-rate-guard   38m ago     2         Succeeded   false\r\n"]
[7.2, "o", "$ "]
[7.9, "o", "rp action revert api-error-rate-guard-7gk2x -n production\r\n"]
[8.2, "o", "requested revert of audit \"api-error-rate-guard-7gk2x\"; the operator will reverse its reversible actions\r\n"]
[9.0, "o", "$ "]
[9.6, "o", "\r\n"]
